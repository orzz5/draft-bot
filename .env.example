DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_application_id
GUILD_ID=your_guild_id

# Shared secret the Vercel proxy passes to the bot's public API.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the SAME value in Vercel as BOT_API_KEY.
BOT_API_KEY=

# GitHub Gist relay — the bot pushes its live payload to a public gist that
# the Vercel dashboard reads (DisCloud free plan cannot expose ports).
# Classic PAT with the "gist" scope: https://github.com/settings/tokens/new
GIST_TOKEN=
# Optional if you created the gist manually; the bot auto-creates it otherwise.
GIST_ID=
# How often the bot checks for changes (ms). Default 15000.
GIST_PUSH_INTERVAL=15000
# Minimum time between actual gist updates (ms). Default 30000.
GIST_MIN_INTERVAL=30000